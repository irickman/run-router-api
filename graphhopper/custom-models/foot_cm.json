{
  "distance_influence": 90,
  "priority": [
    { "if": "!foot_access", "multiply_by": "0" },
    { "if": "toll != NO", "multiply_by": "0" },
    { "else": "", "multiply_by": "foot_priority" },
    { "if": "road_class == RESIDENTIAL || road_class == TERTIARY", "multiply_by": "1.3" },
    { "if": "road_class == FOOTWAY || road_class == PATH", "multiply_by": "0.8" }
  ],
  "speed": [
    { "if": "true", "limit_to": "foot_average_speed" }
  ]
}

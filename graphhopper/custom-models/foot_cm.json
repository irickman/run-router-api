{
  "distance_influence": 10,
  "priority": [
    { "if": "!foot_access", "multiply_by": "0" },
    { "else": "", "multiply_by": "foot_priority" },
    { "if": "road_class == FOOTWAY || road_class == PATH || road_class == PEDESTRIAN", "multiply_by": "1.6" },
    { "if": "road_class == CYCLEWAY || road_class == LIVING_STREET", "multiply_by": "1.4" },
    { "if": "road_class == RESIDENTIAL || road_class == SERVICE", "multiply_by": "1.0" },
    { "if": "road_class == TERTIARY", "multiply_by": "0.8" },
    { "if": "road_class == SECONDARY", "multiply_by": "0.5" },
    { "if": "road_class == PRIMARY", "multiply_by": "0.3" },
    { "if": "road_class == TRUNK", "multiply_by": "0.1" },
    { "if": "surface == ASPHALT || surface == PAVED || surface == CONCRETE", "multiply_by": "1.1" },
    { "if": "surface == COMPACTED || surface == FINE_GRAVEL", "multiply_by": "1.0" },
    { "if": "surface == GRAVEL || surface == DIRT", "multiply_by": "0.8" },
    { "if": "road_environment == FERRY", "multiply_by": "0" }
  ],
  "speed": [
    { "if": "true", "limit_to": "foot_average_speed" }
  ]
}

{
  "distance_influence": 15,
  "priority": [
    { "if": "!foot_access", "multiply_by": "0" },
    { "else": "", "multiply_by": "foot_priority" },
    { "if": "road_class == TRACK || road_class == FOOTWAY || road_class == PATH", "multiply_by": "1.8" },
    { "if": "surface == GRAVEL || surface == DIRT || surface == COMPACTED", "multiply_by": "1.5" },
    { "if": "road_class == RESIDENTIAL || road_class == TERTIARY", "multiply_by": "0.7" },
    { "if": "road_class == SECONDARY || road_class == PRIMARY", "multiply_by": "0.4" },
    { "if": "road_environment == FERRY", "multiply_by": "0" }
  ],
  "speed": [
    { "if": "true", "limit_to": "foot_average_speed" },
    { "if": "average_slope >= 15", "limit_to": "1.5" },
    { "else_if": "average_slope >= 7", "limit_to": "2.5" },
    { "else_if": "average_slope >= 4", "multiply_by": "0.85" }
  ]
}
